universe = vanilla
executable = run_ntuplizer_scan.sh

arguments = "$(sample) $(pt) $(ak) $(ca) $(th) $(ak_int) $(ca_int) $(th_int)"

output = logs/job_$(Cluster)_$(Process).out
error  = logs/job_$(Cluster)_$(Process).err
log    = logs/cluster_$(Cluster).log

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = ""

request_cpus = 1
request_memory = 4GB
request_disk = 10GB

notification = Never

# Keep failed jobs visible in the queue instead of treating a nonzero exit as
# an ordinary completed job. Release a held job after fixing the underlying
# problem, or submit a fresh cluster.
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
on_exit_hold_reason = "Worker failed: ExitCode=$(ExitCode), ExitSignal=$(ExitSignal)"

queue sample,pt,ak,ca,th,ak_int,ca_int,th_int from scan_parameters.tsv
